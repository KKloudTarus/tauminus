{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Grant only what the window uses.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-session-open",
    "allow-session-write",
    "allow-session-write-bytes",
    "allow-session-resize",
    "allow-session-acknowledge",
    "allow-session-close",
    "allow-ssh-open",
    "allow-ssh-prompt-reply"
  ]
}
