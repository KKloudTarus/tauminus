{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Grant only what the window uses.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-session-open",
    "allow-session-write",
    "allow-session-write-bytes",
    "allow-session-resize",
    "allow-session-acknowledge",
    "allow-session-close",
    "allow-ssh-open",
    "allow-ssh-prompt-reply",
    "allow-hosts-list",
    "allow-host-save",
    "allow-host-delete",
    "allow-group-save",
    "allow-group-delete",
    "allow-ssh-config-aliases",
    "allow-hosts-import-ssh-config",
    "allow-host-connect",
    "allow-guard-check",
    "allow-open-link",
    "allow-clipboard-read-text",
    "allow-clipboard-write-text",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-unlock-keychain",
    "allow-vault-lock",
    "allow-vault-touch",
    "allow-vault-set-idle",
    "allow-vault-change-password",
    "allow-vault-set-keychain",
    "allow-identities-list",
    "allow-identity-save",
    "allow-identity-delete"
  ]
}
