{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Grant only what the window uses.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-session-open",
    "allow-session-write",
    "allow-session-write-bytes",
    "allow-session-resize",
    "allow-session-acknowledge",
    "allow-session-close",
    "allow-ssh-open",
    "allow-ssh-prompt-reply",
    "allow-hosts-list",
    "allow-host-save",
    "allow-host-delete",
    "allow-group-save",
    "allow-group-delete",
    "allow-ssh-config-aliases",
    "allow-hosts-import-ssh-config",
    "allow-host-connect",
    "allow-open-link",
    "allow-clipboard-read-text",
    "allow-clipboard-write-text"
  ]
}
